{
  "name": "ordo-server",
  "version": "1.0.0",
  "private": true,
  "description": "Ordo single-node product API and knowledge runtime",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check src/main.js && node --check src/app.js"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.6.1",
    "fflate": "^0.8.2",
    "file-type": "^21.0.0",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "tar-stream": "^3.1.7"
  }
}
