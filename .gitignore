# 运行时数据：SQLite 元数据、内容寻址 Blob、备份、运行密钥（含 master.key，敏感）
.ordo-data/

# 依赖
node_modules/

# Python 虚拟环境与缓存（serverpy/.venv 体积巨大且含二进制）
.venv/
__pycache__/
*.pyc

# 前端构建产物（prestart 会重新生成）
web/dist/

# 日志
*.log

# 浏览器调试产物（可随时重新生成）
runtime-browser-*.png
runtime-browser-*.json

# 本地代理会话状态
.zcode/

# 系统文件
Thumbs.db
.DS_Store
