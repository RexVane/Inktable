node_modules/
dist/
# 根级/各服务的构建产物。apps/desktop/build/ 是 electron-builder 的
# buildResources（应用图标），必须入库，不能被这条规则吞掉。
/build/
output/
apps/desktop/dist/
services/api/dist/
services/api/build/
!apps/desktop/build/
!apps/desktop/build/**
.venv/
__pycache__/
*.pyc
.DS_Store

# 某些工具在 Windows 上把未展开的 %USERPROFILE% 当相对路径写出
# （已实测出现在 apps/desktop/%USERPROFILE%/ 下的 Temp/claude 缓存）
%USERPROFILE%/

# 运行时验收产物：内含活的 SQLite 库、.lock、WAL 与截图，每次跑都不同
runtime-smoke-final-*/
